{
  "name": "wakati",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "supabase": "supabase",
    "brand:generate": "node scripts/brand/generate-derived-assets.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@formatjs/intl-localematcher": "^0.10.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.78.0",
    "negotiator": "^1.1.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "supabase": "^3.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "@opennextjs/aws": {
      "cookie": "0.7.2"
    }
