# -----------------------------------------------------------------------------
# Wakati environment variables
# Copy to `.env.local` for local development. Never commit real values.
# All variables are optional in Phase A: without Supabase the site runs on the
# built-in reference data (categories and locations) and shows no listings.
# -----------------------------------------------------------------------------

# Public base URL, used for canonical URLs, hreflang, sitemap and Open Graph.
# Production example: https://wakati.cm (use your real domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase DEVELOPMENT project (Dashboard → Project Settings → API Keys).
# The publishable key (sb_publishable_…) is designed to be public: row-level
# security in supabase/migrations is what protects the data. Projects that still
# use legacy keys can put the anon JWT here instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY secret key (sb_secret_…; legacy: service_role). Bypasses row-level
# security. Not used by the app yet. Read it only in server code; never prefix it
# with NEXT_PUBLIC_, never expose it to the browser, never put it in a client bundle.
SUPABASE_SECRET_KEY=

# Deployment type: local | development | production. Anything other than
# "production" is noindex (robots.txt, X-Robots-Tag, meta robots). "development"
# also shows the preview banner. Never set "production" on a preview.
NEXT_PUBLIC_DEPLOYMENT_ENV=local

# Optional: shows a "Contact support" link in the footer when set.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Development only: render clearly-labelled layout placeholder boxes in the
# "Latest listings" section when the database has no listings. Ignored in
# production builds. Placeholders contain no prices, titles or sellers.
NEXT_PUBLIC_SHOW_LAYOUT_PLACEHOLDERS=false
